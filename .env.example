# Copy this file to .env and fill in your key. Never commit the real .env.

# Which LLM provider to use. Supported: anthropic, groq
LLM_PROVIDER=groq

# Model name passed to the provider SDK.
# For groq:      openai/gpt-oss-120b
# For anthropic: claude-sonnet-4-6
LLM_MODEL=openai/gpt-oss-120b

# Your Groq API key (required when LLM_PROVIDER=groq). Get one at console.groq.com
GROQ_API_KEY=

# Proactive client-side throttle for Groq calls, in requests/minute.
# Kept conservative by default (well under typical free-tier limits) so
# normal usage shouldn't hit a 429 in the first place. Lower this if you're
# on a stricter tier; raise it if your account has more headroom.
GROQ_REQUESTS_PER_MINUTE=25

# Your Anthropic API key (only needed when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# Path to the lightweight JSON memory store (previous runs' queries/
# sources, used to hint future planning - see app/memory.py). Defaults to
# memory/agent_memory.json under the project root if unset.
RESEARCHPILOT_MEMORY_PATH=
